# Copy to .env (git-ignored). Compose passes it to the api service.
# Dev database/redis run in compose with the defaults baked into settings.py —
# nothing below is needed until the matching feature lands.

# SECRET_KEY=

# Admin superuser — created automatically on api startup if missing (ensure_superuser)
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# Google sign-in. The same web client id twice: compose passes the first to the api
# service, Nuxt reads the second from this same file in dev. No client secret —
# the button returns an id_token we verify against Google's public keys, and only
# the authorization-code flow (which we don't use) needs one.
# GOOGLE_OAUTH_CLIENT_ID=
# NUXT_PUBLIC_GOOGLE_CLIENT_ID=
# YOUTUBE_API_KEY=
# REDDIT_CLIENT_ID=
# REDDIT_CLIENT_SECRET=

# Comma-separated browser origins allowed to call the API (default: http://localhost:3000)
# CORS_ALLOWED_ORIGINS=

# Dramatiq broker, shared by api / worker / scheduler (default: redis://redis:6379/0)
# REDIS_URL=
